# Database configuration
DATABASE_URL=sqlite:poe_items.db
DB_URL=sqlite:poe_items.db

# API Configuration
TRADE_BASE_URL=https://www.pathofexile.com
USER_AGENT="POE2-Scraper/0.1.0 (https://github.com/majorelk/rust-poe2-scraper)"

# Rate limiting
REQUESTS_PER_MIN=60
RATE_LIMIT_DELAY_MS=500

# Logging configuration
RUST_LOG=info
LOG_FORMAT=pretty  # or "json" for structured logs

